{
  "version": 2,
  "builds": [
    {
      "src": "src/pages/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-vercel-protection",
          "value": "none"
        }
      ]
    }
  ]
}
